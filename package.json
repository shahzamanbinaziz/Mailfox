{
  "name": "mailfox",
  "private": true,
  "version": "0.1.0",
  "description": "Mailfox — self-hosted, permission-based email campaign platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @mailfox/db generate",
    "db:migrate": "pnpm --filter @mailfox/db migrate:dev",
    "db:deploy": "pnpm --filter @mailfox/db migrate:deploy",
    "db:seed": "pnpm --filter @mailfox/db seed",
    "brand:build": "pnpm --filter @mailfox/brand assets",
    "tokens:build": "pnpm --filter @mailfox/ui tokens:build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild",
      "@prisma/client"
    ]
  }
}
