# ─────────────────────────────────────────────────────────────
# Mailfox environment. Copy to `.env` and fill in.
# `docker compose up` works with these defaults for local dev.
# ─────────────────────────────────────────────────────────────

# General
NODE_ENV=development
APP_URL=http://localhost:3000
# Extra hosts allowed to call Server Actions (comma-separated, read at build time), e.g. app.mailfox.com
SERVER_ACTIONS_ALLOWED_ORIGINS=
TRACKING_URL=http://localhost:3001
TZ=UTC

# Database (Postgres)
POSTGRES_USER=mailfox
POSTGRES_PASSWORD=mailfox
POSTGRES_DB=mailfox
DATABASE_URL=postgresql://mailfox:mailfox@localhost:5432/mailfox

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Security
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# Auth.js session secret. Generate: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
# HMAC key for signed tracking/unsubscribe links
TRACKING_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET

# Mail sending
# dev  -> all mail goes to Mailpit, no matter which mailbox is selected
# live -> mail goes to the real SMTP server of each mailbox
SEND_MODE=dev
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025

# AI (Google Gemini, free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM_LIMIT=10
GEMINI_RPD_LIMIT=250

# Seed data
SEED_ADMIN_EMAIL=admin@mailfox.local
SEED_ADMIN_PASSWORD=mailfox-admin-123
SEED_COMPANY_ADDRESS="Mailfox HQ, 1 Fox Lane, Lahore, Pakistan"
