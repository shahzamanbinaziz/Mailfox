{
  "name": "@mailfox/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prisma schema, migrations, seed and client",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mailfox/core": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@mailfox/email": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  }
}
